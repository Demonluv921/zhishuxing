# ===== 智刷星配置 =====
# 服务端口
PORT=3000

# 会话密钥(生产环境请改为随机长字符串)
SESSION_SECRET=please-change-me-to-a-long-random-string

# DeepSeek API 密钥(必填,用于 AI 出题 / 苏格拉底式讲题)
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# DeepSeek 模型(deepseek-chat 即 DeepSeek-V3,deepseek-reasoner 为 R1)
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek API 地址(一般无需修改)
DEEPSEEK_BASE_URL=https://api.deepseek.com
